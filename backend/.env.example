# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development

# MongoDB Atlas connection string (Database > Connect > Drivers). The path after the host
# is the database name. URL-encode special characters in the password.
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vaadakaro?retryWrites=true&w=majority

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=60

# JSON list
CORS_ORIGINS=["http://localhost:3000"]
# Production (Render): CORS_ORIGINS=["https://vaada-karo.vercel.app"]

# memory:// for one instance; Upstash/Redis URL (rediss://...) when running several.
RATE_LIMIT_STORAGE_URI=memory://

# Shared with the frontend (same value in frontend/.env.local) so its proxy can report each
# visitor's real IP for rate limiting. Optional locally. Generate like JWT_SECRET.
PROXY_SHARED_SECRET=

# https://aistudio.google.com/apikey  (check current model names and free-tier limits)
GEMINI_API_KEY=
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Cloudflare R2 (free 10 GB). Leave blank to disable uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vaadakaro-uploads

# IT (Intermediary Guidelines) Rules 2021, rule 3(2): publish the appointed Grievance Officer's
# name and contact. Required before launch; shown on /grievance and the privacy notice.
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=grievance@vaadakaro.in
GRIEVANCE_OFFICER_ADDRESS=
# Bump together with NOTICE_VERSION in frontend/src/app/privacy/page.tsx when the notice changes.
PRIVACY_NOTICE_VERSION=2026-10-26
