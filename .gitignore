# Root .gitignore for VaadaKaro

# Environment variables
.env
.env.local
.env.*.local

# Dependencies
node_modules/
backend/.venv/
.venv/

# Build outputs
frontend/.next/
.next/
out/
build/
dist/

# Python cache & test artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# TypeScript cache
*.tsbuildinfo

# IDE & OS files
.DS_Store
Thumbs.db
*.log
.claude/
