# Copy to .env.local. Never commit it.

# Where the FastAPI backend runs (server-side only; the browser talks to /api/v1 on this app).
API_URL=http://localhost:8000
# Production (Vercel): API_URL=https://vaadakaro.onrender.com

# Per-user rate limiting in production. Leave both empty locally.
# TRUSTED_IP_HEADER: a header your host sets itself with the visitor's IP
#   (Vercel: x-real-ip, Cloudflare: cf-connecting-ip). Never x-forwarded-for: browsers can fake it.
# PROXY_SHARED_SECRET: same value as PROXY_SHARED_SECRET in backend/.env.
TRUSTED_IP_HEADER=
PROXY_SHARED_SECRET=
